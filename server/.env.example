# --- server ---
PORT=3000
NODE_ENV=development
# Development login ("Authorization: Bearer dev:<id>:<handle>"). Forced off in production. Use with in-memory storage only.
DEV_AUTH=1
CORS_ORIGIN=*

# --- Supabase (Project Settings > API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Legacy projects: Project Settings > API > JWT Secret. Leave empty if your project uses asymmetric signing keys (JWKS).
SUPABASE_JWT_SECRET=
# Only needed so DELETE /v1/me can also remove the auth user. Server-side only; never ship this to the app.
SUPABASE_SERVICE_ROLE_KEY=
# Use the pooled connection string. Leave empty to run fully in memory.
DATABASE_URL=

# --- Gemini (kept on the server) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Second, independent model pass that must approve every AI candidate. Fails closed.
AI_REVIEW=1

# --- LiveKit (cloud.livekit.io > Settings > Keys) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Clips / Feed (optional) ---
# Private Supabase Storage bucket for recorded clips (create it in the dashboard, Public OFF).
CLIPS_BUCKET=clips
# Supabase Storage S3 credentials (Project Settings > Storage > S3 Connection). LiveKit Egress uploads with these.
CLIPS_S3_ACCESS_KEY=
CLIPS_S3_SECRET=
CLIPS_S3_ENDPOINT=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
CLIPS_S3_REGION=us-east-1
# Development only: fill the Feed with labelled demo clips (public sample videos). Forced off in production.
DEMO_CLIPS=1
